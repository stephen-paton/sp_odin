package sp_music_tests

import "core:testing"

import "sp:music"

@(test)
test__Note__relative__ScaleDegreeTooLow :: proc(t: ^testing.T) {
    root := music.Note__C()
    relative: music.Note
    err: music.Note__Err__relative

    relative, err = music.Note__relative(root, { number = 0, accidental = music.Accidental__NATURAL })
    testing.expect(t, err == .ScaleDegreeTooLow)
}

@(test)
test__Note__relative__F :: proc(t: ^testing.T) {
    root := music.Note__F()
    relative: music.Note
    err: music.Note__Err__relative

    // 1 (F)
    relative, err = music.Note__relative(root, music.ScaleDegree__1())
    testing.expect(t, relative.letter == .F)
    testing.expect(t, relative.accidental == music.Accidental__NATURAL)
    testing.expect(t, err == .Ok)
    // 2b (Gb)
    relative, err = music.Note__relative(root, music.ScaleDegree__2b())
    testing.expect(t, relative.letter == .G)
    testing.expect(t, relative.accidental == music.Accidental__FLAT)
    testing.expect(t, err == .Ok)
    // 2 (G)
    relative, err = music.Note__relative(root, music.ScaleDegree__2())
    testing.expect(t, relative.letter == .G)
    testing.expect(t, relative.accidental == music.Accidental__NATURAL)
    testing.expect(t, err == .Ok)
    // 3b (Ab)
    relative, err = music.Note__relative(root, music.ScaleDegree__3b())
    testing.expect(t, relative.letter == .A)
    testing.expect(t, relative.accidental == music.Accidental__FLAT)
    testing.expect(t, err == .Ok)
    // 3 (A)
    relative, err = music.Note__relative(root, music.ScaleDegree__3())
    testing.expect(t, relative.letter == .A)
    testing.expect(t, relative.accidental == music.Accidental__NATURAL)
    testing.expect(t, err == .Ok)
    // 4 (Bb)
    relative, err = music.Note__relative(root, music.ScaleDegree__4())
    testing.expect(t, relative.letter == .B)
    testing.expect(t, relative.accidental == music.Accidental__FLAT)
    testing.expect(t, err == .Ok)
    // 4# (B)
    relative, err = music.Note__relative(root, music.ScaleDegree__4s())
    testing.expect(t, relative.letter == .B)
    testing.expect(t, relative.accidental == music.Accidental__NATURAL)
    testing.expect(t, err == .Ok)
    // 5b (Cb)
    relative, err = music.Note__relative(root, music.ScaleDegree__5b())
    testing.expect(t, relative.letter == .C)
    testing.expect(t, relative.accidental == music.Accidental__FLAT)
    testing.expect(t, err == .Ok)
    // 5 (C)
    relative, err = music.Note__relative(root, music.ScaleDegree__5())
    testing.expect(t, relative.letter == .C)
    testing.expect(t, relative.accidental == music.Accidental__NATURAL)
    testing.expect(t, err == .Ok)
    // 5# (Cs)
    relative, err = music.Note__relative(root, music.ScaleDegree__5s())
    testing.expect(t, relative.letter == .C)
    testing.expect(t, relative.accidental == music.Accidental__SHARP)
    testing.expect(t, err == .Ok)
    // 6b (Db)
    relative, err = music.Note__relative(root, music.ScaleDegree__6b())
    testing.expect(t, relative.letter == .D)
    testing.expect(t, relative.accidental == music.Accidental__FLAT)
    testing.expect(t, err == .Ok)
    // 6 (D)
    relative, err = music.Note__relative(root, music.ScaleDegree__6())
    testing.expect(t, relative.letter == .D)
    testing.expect(t, relative.accidental == music.Accidental__NATURAL)
    testing.expect(t, err == .Ok)
    // 7b (Eb)
    relative, err = music.Note__relative(root, music.ScaleDegree__7b())
    testing.expect(t, relative.letter == .E)
    testing.expect(t, relative.accidental == music.Accidental__FLAT)
    testing.expect(t, err == .Ok)
    // 7 (E)
    relative, err = music.Note__relative(root, music.ScaleDegree__7())
    testing.expect(t, relative.letter == .E)
    testing.expect(t, relative.accidental == music.Accidental__NATURAL)
    testing.expect(t, err == .Ok)
    // 9b (Gb)
    relative, err = music.Note__relative(root, music.ScaleDegree__9b())
    testing.expect(t, relative.letter == .G)
    testing.expect(t, relative.accidental == music.Accidental__FLAT)
    testing.expect(t, err == .Ok)
    // 9 (G)
    relative, err = music.Note__relative(root, music.ScaleDegree__9())
    testing.expect(t, relative.letter == .G)
    testing.expect(t, relative.accidental == music.Accidental__NATURAL)
    testing.expect(t, err == .Ok)
    // 9# (Gs)
    relative, err = music.Note__relative(root, music.ScaleDegree__9s())
    testing.expect(t, relative.letter == .G)
    testing.expect(t, relative.accidental == music.Accidental__SHARP)
    testing.expect(t, err == .Ok)
    // 11 (Bb)
    relative, err = music.Note__relative(root, music.ScaleDegree__11())
    testing.expect(t, relative.letter == .B)
    testing.expect(t, relative.accidental == music.Accidental__FLAT)
    testing.expect(t, err == .Ok)
    // 11# (B)
    relative, err = music.Note__relative(root, music.ScaleDegree__11s())
    testing.expect(t, relative.letter == .B)
    testing.expect(t, relative.accidental == music.Accidental__NATURAL)
    testing.expect(t, err == .Ok)
    // 13b (Db)
