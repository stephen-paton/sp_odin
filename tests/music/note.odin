    testing.expect(t, relative.accidental == music.Accidental__FLAT)
    testing.expect(t, err == .Ok)
    // 13 (D)
    relative, err = music.Note__relative(root, music.ScaleDegree__13())
    testing.expect(t, relative.letter == .D)
    testing.expect(t, relative.accidental == music.Accidental__NATURAL)
    testing.expect(t, err == .Ok)
}

